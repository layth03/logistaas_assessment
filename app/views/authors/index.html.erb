<h1>Authors</h1>

<%= form_for_filterrific @filterrific do |f| %>
  <div>
    <%= f.label :search_by_name, "Search by name" %>
    <%= f.text_field :search_by_name %>
  </div>

  <%= f.submit "Search" %>

  <%= link_to "Clear", authors_path %>
<% end %>
<%= link_to "Back to Books", books_path %>
<hr>

<% @authors.each do |author| %>
  <p><%= author.name %></p>
<% end %>