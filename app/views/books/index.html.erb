<h1>Books</h1>

<%= render "filters" %>
<%= link_to "Download CSV",
            books_path(request.query_parameters.merge(format: :csv)) %>
<hr>
<%= link_to "New Book", new_book_path %>
<% @books.each do |book| %>
  <p>
    <%=  link_to book.name, book_path(book) %> -
    <%= book.release_date %> -
    <%= book.author.name %>
  </p>
<% end %>