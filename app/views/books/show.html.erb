<h1><%= @book.name %></h1>

<p>
  <strong>Release date:</strong>
  <%= @book.release_date %>
</p>

<p>
  <strong>Author:</strong>
  <%= @book.author.name %>
</p>

<%= link_to "Back to Books", books_path %>
<% if @book.author == current_author %>
  <%= link_to "Edit Book", edit_book_path(@book) %>
  <%= button_to "Delete Book", book_path(@book), method: :delete %>
<% end %>